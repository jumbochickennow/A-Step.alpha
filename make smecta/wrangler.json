{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "a-step-immigration-space",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "worker/index.ts",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "www.astepimmigration.space/*",
			"zone_name": "astepimmigration.space"
		},
		{
			"pattern": "astepimmigration.space/*",
			"zone_name": "astepimmigration.space"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/*"
		]
	},
	"secrets": {
		"required": [
			"TURNSTILE_SECRET_KEY",
			"TURNSTILE_ALLOWED_HOSTNAMES",
			"ALLOWED_ORIGINS",
			"PII_ENCRYPTION_KEY_V1",
			"BLIND_INDEX_SECRET",
			"ADMIN_PASSWORD_HASH",
			"ADMIN_PASSWORD_PEPPER",
			"RESOURCE_REF_SECRET"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "ADMIN_SECURITY",
				"class_name": "AdminSecurityCoordinator"
			},
			{
				"name": "RATE_LIMITER",
				"class_name": "AtomicRateLimiter"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-security-coordinators",
			"new_sqlite_classes": [
				"AdminSecurityCoordinator",
				"AtomicRateLimiter"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "astep-production-db",
			"database_id": "b9f6f42a-2b44-4429-9865-a4cfc7a2febd",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "GUIDES_BUCKET",
			"bucket_name": "a-step-guides"
		},
		{
			"binding": "OPPORTUNITY_IMAGES_BUCKET",
			"bucket_name": "a-step-opportunity-images"
		}
	],
	"send_email": [
		{
			"name": "CONTACT_EMAIL",
			"destination_address": "contact@astepimmigration.space",
			"allowed_sender_addresses": [
				"contact@astepimmigration.space"
			],
			"remote": true
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "EVENT_QUEUE",
				"queue": "a-step-outbox"
			}
		],
		"consumers": [
			{
				"queue": "a-step-outbox",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "a-step-outbox-dlq",
				"max_concurrency": 1
			}
		]
	},
	"triggers": {
		"crons": [
			"*/1 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
