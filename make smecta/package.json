{
  "name": "a-step-immigration-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:i18n",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-translations.mjs",
    "check": "npm run check:i18n && tsc -b --pretty false",
    "check:worker": "tsc -p tsconfig.worker.json --pretty false",
    "verify:env": "node scripts/verify-env.mjs",
    "verify:d1": "node scripts/verify-d1.mjs",
    "verify:d1:remote": "node scripts/verify-d1.mjs --remote",
    "scan:secrets": "node scripts/scan-staged-secrets.mjs",
    "scan:secrets:all": "node scripts/scan-staged-secrets.mjs --working-tree",
    "check:assets": "node scripts/check-public-assets.mjs",
    "test:security": "esbuild scripts/phase3-security-assertions.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/security-assertions.mjs --log-level=error && node node_modules/.cache/security-assertions.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "audit:health": "node scripts/audit-health.mjs",
    "audit:all": "npm run audit:health && npm run check:i18n && tsc -b",
    "preview:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.66.9",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "react-router-dom": "7.18.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wrangler": "^4.125.0"
  }
}
